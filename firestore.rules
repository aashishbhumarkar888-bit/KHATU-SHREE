rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all - Fortress zero-trust pattern
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email in ['aashishbhumarkar888@gmail.com', 'admin@khatushri.in']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt']) &&
        data.keys().hasOnly([
          'userId', 'email', 'name', 'displayName', 'photoURL', 'phoneNumber',
          'bhopalArea', 'address', 'pincode', 'khatuPoints', 'resellerMarkup',
          'referralCode', 'cart', 'wishlist', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32)) &&
        (!('bhopalArea' in data) || (data.bhopalArea is string && data.bhopalArea.size() <= 128)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 1024)) &&
        (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 16)) &&
        (!('khatuPoints' in data) || (data.khatuPoints is number && data.khatuPoints >= 0)) &&
        (!('resellerMarkup' in data) || (data.resellerMarkup is number && data.resellerMarkup >= 0)) &&
        (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 64)) &&
        (!('cart' in data) || (data.cart is list && data.cart.size() <= 100)) &&
        (!('wishlist' in data) || (data.wishlist is list && data.wishlist.size() <= 200));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'userId', 'items', 'wholesaleTotal', 'resaleValue', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'orderId', 'userId', 'items', 'wholesaleTotal', 'resaleValue',
          'address', 'deliveryMethod', 'packagingChoice', 'paymentMode',
          'statusTimeline', 'status', 'total', 'subtotal', 'deliveryCharge',
          'discount', 'currency', 'customerName', 'customerEmail', 'customerPhone',
          'shippingAddress', 'paymentMethod', 'deliverySlot', 'deliveryInstructions',
          'instructions', 'trackingNumber', 'createdAt', 'updatedAt'
        ]) &&
        data.orderId is string && data.orderId.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
        data.wholesaleTotal is number && data.wholesaleTotal >= 0 &&
        data.resaleValue is number && data.resaleValue >= 0 &&
        data.status in ['placed', 'processing', 'out_for_delivery', 'shipped', 'delivered', 'cancelled'] &&
        (!('deliveryMethod' in data) || (data.deliveryMethod is string && data.deliveryMethod.size() <= 128)) &&
        (!('packagingChoice' in data) || (data.packagingChoice is string && data.packagingChoice.size() <= 128)) &&
        (!('paymentMode' in data) || (data.paymentMode is string && data.paymentMode.size() <= 64)) &&
        (!('statusTimeline' in data) || (data.statusTimeline is list && data.statusTimeline.size() <= 50));
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['userId', 'productIds', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'productIds', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.productIds is list && data.productIds.size() <= 200;
    }

    // 1. Users collection: users can only read/write their own user document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // 2. Orders collection: users can only read/write their own orders; admins can manage all orders
    match /orders/{orderId} {
      allow get: if (isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if (isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid && isValidOrder(incoming()) && incoming().userId == existing().userId) || (isAdmin() && isValidId(orderId));
      allow delete: if isAdmin();
    }

    // 3. Wishlists collection: users can only read/write their own wishlist document
    match /wishlists/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidWishlist(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 4. Products collection: public catalog read, admin manage
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(productId);
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
